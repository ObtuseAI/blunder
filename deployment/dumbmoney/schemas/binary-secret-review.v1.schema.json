{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dumbmoney:schema:binary-secret-review:v1",
  "title": "DumbMoney binary payload secret-review attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "migration_id",
    "manifest_sha256",
    "status",
    "reviewer",
    "reviewed_at",
    "methodology",
    "compressed_or_non_utf8_limitations_acknowledged",
    "reviewed_files"
  ],
  "properties": {
    "schema_version": {
      "const": "dumbmoney.binary-secret-review.v1"
    },
    "migration_id": {
      "type": "string",
      "format": "uuid"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "const": "REVIEWED_NO_SECRETS"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "methodology": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "compressed_or_non_utf8_limitations_acknowledged": {
      "const": true
    },
    "reviewed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packaged_path",
          "sha256",
          "result"
        ],
        "properties": {
          "packaged_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "result": {
            "const": "NO_SECRET_MATERIAL_FOUND"
          }
        }
      }
    }
  }
}
