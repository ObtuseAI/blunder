<!-- PLAN-ONLY TEMPLATE: render only from a PASS sealed release. -->
<service>
  <id>DumbMoneyCore</id>
  <name>DumbMoney Core</name>
  <description>DumbMoney control ledger and capital governor.</description>
  <executable>{{DUMBMONEY_CORE_EXECUTABLE}}</executable>
  <!-- Core arguments render only from the exact path-and-digest manifest binding. -->
  <arguments>{{DUMBMONEY_CORE_ARGUMENTS}}</arguments>
  <workingdirectory>{{DUMBMONEY_RELEASE_ROOT}}</workingdirectory>
  <stoptimeout>30sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
  <env name="DUMBMONEY_SERVICE_NAME" value="DumbMoneyCore" />
  <env name="DUMBMONEY_PROGRAM_DATA" value="{{DUMBMONEY_PROGRAM_DATA}}" />
  <env name="DUMBMONEY_RELEASE_ID" value="{{DUMBMONEY_RELEASE_ID}}" />
  <env name="DUMBMONEY_TELEMETRY_PUBLICATION" value="disabled" />
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
