<!-- PLAN-ONLY TEMPLATE: resolve OpenRouter credentials from the service secret store. -->
<service>
  <id>DumbMoneyModelGateway</id>
  <name>DumbMoney Model Gateway</name>
  <description>OpenRouter model routing, data classification, and the hard daily spend ceiling.</description>
  <executable>{{DUMBMONEY_MODEL_GATEWAY_EXECUTABLE}}</executable>
  <arguments>{{DUMBMONEY_MODEL_GATEWAY_ARGUMENTS}}</arguments>
  <workingdirectory>{{DUMBMONEY_RELEASE_ROOT}}</workingdirectory>
  <depend>DumbMoneyCore</depend>
  <stoptimeout>30sec</stoptimeout>
  <onfailure action="restart" delay="15 sec" />
  <env name="DUMBMONEY_SERVICE_NAME" value="DumbMoneyModelGateway" />
  <env name="DUMBMONEY_PROGRAM_DATA" value="{{DUMBMONEY_PROGRAM_DATA}}" />
  <env name="DUMBMONEY_RELEASE_ID" value="{{DUMBMONEY_RELEASE_ID}}" />
  <env name="DUMBMONEY_TELEMETRY_PUBLICATION" value="disabled" />
  <env name="DUMBMONEY_OPENROUTER_BUDGET_USD" value="10.00" />
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
